# NWN Modules Translator - copy to .env in the project directory.

# OpenRouter keys usually start with sk-or-...
# POLZA.AI keys are also supported and are selected by prefix automatically.
NWN_TRANSLATE_API_KEY=your_api_key_here

# Parallel AI requests (async coroutines, not OS threads). If unset, default is 12.
# Use 10-12 if you see HTTP 429; 15-20 can be fine on higher tiers / stable networks.
# NWN_TRANSLATE_MAX_CONCURRENT=12

# Prompt cache breakpoints are enabled by default for providers that support them.
# Set to 0 if a gateway rejects the extra cache_control field.
# NWN_TRANSLATE_PROMPT_CACHE=1

# Glossary timeouts, in seconds.
# NWN_GLOSSARY_LLM_TIMEOUT=300
# NWN_GLOSSARY_RUN_TIMEOUT=360

# Web backend.
# NWN_WEB_HOST=127.0.0.1
# NWN_WEB_PORT=8000
# NWN_WEB_RELOAD=1
# NWN_WEB_CORS_ORIGINS=*
# NWN_WEB_TASK_ROOT=workspace/web
# NWN_WEB_DB_PATH=workspace/web/translations.db
# NWN_WEB_STATIC_DIR=
# NWN_WEB_TRUSTED_PROXIES=
