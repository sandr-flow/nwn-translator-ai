# Example variables for docker-compose.
# Copy to docker/.env if you want to override compose defaults.

# Required for translation. OpenRouter keys usually start with sk-or-...;
# POLZA.AI keys are also supported and are selected by prefix automatically.
NWN_TRANSLATE_API_KEY=your_api_key_here

# docker-compose.yml sets NWN_WEB_TASK_ROOT to /data/tasks and
# NWN_WEB_DB_PATH to /data/db/translations.db (both on named volumes), and
# trusts X-Forwarded-For from the nginx container's fixed address
# (NWN_WEB_TRUSTED_PROXIES=172.28.0.10).

# CORS for direct API access, if requests bypass nginx.
# NWN_WEB_CORS_ORIGINS=https://example.com,https://www.example.com

# Optional tuning.
# NWN_TRANSLATE_MAX_CONCURRENT=12
# NWN_TRANSLATE_PROMPT_CACHE=1
# NWN_GLOSSARY_LLM_TIMEOUT=300
# NWN_GLOSSARY_RUN_TIMEOUT=360
